{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "trustedDependencies": [],
  "scripts": {
    "api-url": "bun -e 'await Bun.write(\"src/api/base.ts\", `export const API_BASE = ${JSON.stringify(process.env.VITE_API_URL ?? \"http://localhost:4201\")};\\n`)'",
    "dev": "bun run api-url && bun ./serve.ts",
    "build": "bun run api-url && tsc -b && bun build ./index.html --outdir dist --minify",
    "lint": "oxlint",
    "preview": "bun --port ${SUBSPACE_FRONT_PORT:-4200} ./dist/index.html",
    "codegen": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
